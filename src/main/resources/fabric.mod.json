{
  "schemaVersion": 1,
  "id": "rei_search_bar_calculations",
  "version": "${version}",
  "name": "REI Search Bar Calculations",
  "description": "A mod that adds an option to use the search bar as a calculator, similar to the NEU (Not Enough Updates) mod for Hypixel Skyblock.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.BigBou.rei_search_bar_calculations.client.ReiSearchBarCalculationsClient"
    ],
    "main": [
      "me.BigBou.rei_search_bar_calculations.ReiSearchBarCalculations"
    ],
    "rei_client": [
      "me.BigBou.rei_search_bar_calculations.client.CalculatorSearch"
    ],
    "modmenu": [
      "me.BigBou.rei_search_bar_calculations.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "rei_search_bar_calculations.mixins.json",
    {
      "config": "rei_search_bar_calculations.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": ">=${minecraft_version}",
    "roughlyenoughitems": ">=${rei_version}",
    "yet_another_config_lib_v3": ">=${yacl_version}",
    "modmenu": ">=${modmenu_version}"
  }
}
